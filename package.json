{
  "name": "db11-ai-tools-workspace",
  "private": true,
  "type": "module",
  "description": "Workspace coordinator for independently published DB11 Pi packages.",
  "author": "debonzi",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test:behavior && npm run test:package && npm run test:install && npm run test:release && npm run test:shell",
    "test:behavior": "npm run test:extensions",
    "test:extensions": "TZ=UTC node --test packages/pi-codex-usage/agents/pi/extensions/codex-usage/core.test.ts packages/pi-codex-usage/agents/pi/extensions/codex-usage/index.test.ts packages/pi-copilot-usage/agents/pi/extensions/copilot-usage/core.test.ts packages/pi-copilot-usage/agents/pi/extensions/copilot-usage/index.test.ts",
    "test:package": "python3 tests/test_package.py -v",
    "test:install": "tests/test-package-install.sh",
    "test:release": "python3 tests/test_release.py -v",
    "test:shell": "bash -n tests/test-package-install.sh",
    "pack:check": "python3 tests/test_package.py PackageArchiveTests -v",
    "check": "npm test"
  },
  "devDependencies": {
    "@changesets/cli": "2.29.8"
  },
  "packageManager": "npm@12.0.1"
}
