  "scripts": {
    "test": "npm run test:python && npm run test:workflows && npm run test:e2e && npm run test:extensions && npm run test:shell",
    "test:python": "python3 -m unittest discover -s skills/dbz-ai-tools-setup/tests -v && python3 -m unittest discover -s skills/dbz-crew/tests -v && python3 tests/test_dbz_issues.py -v && python3 tests/test_package.py -v",
    "test:workflows": "TZ=UTC node --test skills/dbz-workflows/lib/*.test.mjs",
    "test:e2e": "TZ=UTC node --test tests/dbz-workflows-e2e.test.mjs",
    "test:extensions": "TZ=UTC node --test agents/pi/extensions/codex-usage/core.test.ts agents/pi/extensions/dbz-crew-events/index.test.ts agents/pi/extensions/dbz-workflows/*.test.ts",
    "test:shell": "tests/test-package-install.sh && tests/test-install.sh",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "check": "npm test",
    "prepack": "npm run check"
  },
  "peerDependencies": {
