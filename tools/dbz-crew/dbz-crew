#!/usr/bin/env python3
"""Operate the local DBZ Crew workflow without third-party dependencies."""

from __future__ import annotations

import argparse
from contextlib import contextmanager
import errno
import fcntl
import hashlib
import json
import os
import pwd
import re
import shutil
import stat
import subprocess
import sys
import time
import uuid
from pathlib import Path
from typing import Any, Iterator


TASK_ID_RE = re.compile(r"^[a-z][a-z0-9-]{0,23}$")
WORKER_PHASES = {"implementation", "rebase"}
PI_AGENT_KIND = "pi"
PI_THINKING_LEVELS = {"off", "minimal", "low", "medium", "high", "xhigh", "max"}
READ_ONLY_MODES = {"isolated", "in-place"}
STATE_DIRECTORY_PARTS = (".local", "state", "dbz-crew")
PRIVATE_DIRECTORY_MODE = 0o700
PRIVATE_FILE_MODE = 0o600


class CrewError(RuntimeError):
    """Expected workflow failure that should be shown without a traceback."""


def command(args: list[str], cwd: Path | None = None) -> subprocess.CompletedProcess[str]:
    return subprocess.run(args, cwd=cwd, capture_output=True, text=True, check=False)


def command_text(args: list[str], cwd: Path | None = None) -> str:
    result = command(args, cwd)
    if result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip() or "command failed"
        raise CrewError(f"{' '.join(args)}: {detail}")
    return result.stdout.strip()


def command_bytes(args: list[str], cwd: Path | None = None) -> subprocess.CompletedProcess[bytes]:
    return subprocess.run(args, cwd=cwd, capture_output=True, text=False, check=False)


def bytes_command_output(args: list[str], cwd: Path | None = None) -> bytes:
    result = command_bytes(args, cwd)
    if result.returncode != 0:
        detail = os.fsdecode(result.stderr).strip() or os.fsdecode(result.stdout).strip() or "command failed"
        raise CrewError(f"{' '.join(args)}: {detail}")
    return result.stdout


def json_from_text(value: str) -> Any:
    start = value.find("{")
    if start < 0:
        raise CrewError("expected JSON output")
    try:
        return json.loads(value[start:])
    except json.JSONDecodeError as exc:
        raise CrewError(f"invalid JSON output: {exc}") from exc


def find_values(value: Any, key: str) -> list[Any]:
    if isinstance(value, dict):
        found = [value[key]] if key in value else []
        for child in value.values():
            found.extend(find_values(child, key))
        return found
    if isinstance(value, list):
        found: list[Any] = []
        for child in value:
            found.extend(find_values(child, key))
        return found
    return []


def first_string(value: Any, key: str) -> str | None:
    for candidate in find_values(value, key):
        if isinstance(candidate, str) and candidate:
            return candidate
    return None


def account_home() -> Path:
    """Return the current account home without consulting environment variables."""
    try:
        home = Path(pwd.getpwuid(os.getuid()).pw_dir)
    except (KeyError, OSError) as exc:
        raise CrewError(f"unable to resolve the current account home: {exc}") from exc
    if not home.is_absolute():
        raise CrewError(f"the current account home is not absolute: {home}")
    return home


def state_root() -> Path:
    return account_home().joinpath(*STATE_DIRECTORY_PARTS)


def _state_open_flags(*, directory: bool = False) -> int:
    required = ("O_CLOEXEC", "O_NOFOLLOW")
    missing = [name for name in required if not hasattr(os, name)]
    if directory and not hasattr(os, "O_DIRECTORY"):
        missing.append("O_DIRECTORY")
    if missing:
        raise CrewError("secure state handling is unavailable: missing " + ", ".join(missing))
    flags = os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW
    if directory:
        flags |= os.O_DIRECTORY
    return flags


def _validate_owned_directory(descriptor: int, path: Path, *, private: bool) -> None:
    try:
        info = os.fstat(descriptor)
    except OSError as exc:
        raise CrewError(f"unable to inspect DBZ Crew state directory {path}: {exc}") from exc
    if not stat.S_ISDIR(info.st_mode):
        raise CrewError(f"DBZ Crew state path is not a directory: {path}")
    if info.st_uid != os.getuid():
        raise CrewError(f"DBZ Crew state directory is not owned by the current user: {path}")
    if private:
        try:
            os.fchmod(descriptor, PRIVATE_DIRECTORY_MODE)
        except OSError as exc:
            raise CrewError(f"unable to make DBZ Crew state directory private {path}: {exc}") from exc
    elif info.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
        raise CrewError(f"DBZ Crew state parent is writable by other users: {path}")


def _validate_owned_file(descriptor: int, path: Path) -> None:
    try:
        info = os.fstat(descriptor)
    except OSError as exc:
        raise CrewError(f"unable to inspect DBZ Crew state file {path}: {exc}") from exc
    if not stat.S_ISREG(info.st_mode):
        raise CrewError(f"DBZ Crew state path is not a regular file: {path}")
    if info.st_uid != os.getuid():
        raise CrewError(f"DBZ Crew state file is not owned by the current user: {path}")
    try:
        os.fchmod(descriptor, PRIVATE_FILE_MODE)
    except OSError as exc:
        raise CrewError(f"unable to make DBZ Crew state file private {path}: {exc}") from exc


def _reject_repository_local_state_root(root: Path) -> None:
    current = root
    while True:
        marker = current / ".git"
        try:
            os.lstat(marker)
        except FileNotFoundError:
            pass
        except OSError as exc:
            raise CrewError(f"unable to inspect DBZ Crew state ancestry at {marker}: {exc}") from exc
        else:
            raise CrewError(f"DBZ Crew state directory cannot be inside a Git worktree: {root}")
        parent = current.parent
        if parent == current:
            return
        current = parent


def _open_child_directory(
    parent_descriptor: int,
    name: str,
    path: Path,
    *,
    create: bool,
    private: bool,
) -> int:
    try:
        info = os.stat(name, dir_fd=parent_descriptor, follow_symlinks=False)
    except FileNotFoundError:
        if not create:
            raise FileNotFoundError(errno.ENOENT, os.strerror(errno.ENOENT), str(path))
        try:
            os.mkdir(name, PRIVATE_DIRECTORY_MODE, dir_fd=parent_descriptor)
        except FileExistsError:
            pass
        except OSError as exc:
            raise CrewError(f"unable to create DBZ Crew state directory {path}: {exc}") from exc
    except OSError as exc:
        raise CrewError(f"unable to inspect DBZ Crew state directory {path}: {exc}") from exc
    else:
        if stat.S_ISLNK(info.st_mode):
            raise CrewError(f"DBZ Crew state directory cannot be a symbolic link: {path}")
        if not stat.S_ISDIR(info.st_mode):
            raise CrewError(f"DBZ Crew state path is not a directory: {path}")

    try:
        descriptor = os.open(name, _state_open_flags(directory=True), dir_fd=parent_descriptor)
    except OSError as exc:
        raise CrewError(f"unable to open DBZ Crew state directory {path} without following links: {exc}") from exc
    try:
        _validate_owned_directory(descriptor, path, private=private)
    except BaseException:
        os.close(descriptor)
        raise
    return descriptor


@contextmanager
def _open_state_root(*, create: bool) -> Iterator[int]:
    root = state_root()
    home = account_home()
    _reject_repository_local_state_root(root)
    try:
        home_descriptor = os.open(home, os.O_RDONLY | os.O_CLOEXEC | os.O_DIRECTORY)
    except OSError as exc:
        raise CrewError(f"unable to open the current account home {home}: {exc}") from exc
    descriptors = [home_descriptor]
    try:
        _validate_owned_directory(home_descriptor, home, private=False)
        current_path = home
        for index, part in enumerate(STATE_DIRECTORY_PARTS):
            current_path /= part
            descriptor = _open_child_directory(
                descriptors[-1],
                part,
                current_path,
                create=create,
                private=index == len(STATE_DIRECTORY_PARTS) - 1,
            )
            descriptors.append(descriptor)
        yield descriptors[-1]
    finally:
        for descriptor in reversed(descriptors):
            os.close(descriptor)


def _state_relative_parts(path: Path) -> tuple[str, ...]:
    root = state_root()
    if not path.is_absolute():
        raise CrewError(f"DBZ Crew state path is not absolute: {path}")
    try:
        relative = path.relative_to(root)
    except ValueError as exc:
        raise CrewError(f"state path is outside the DBZ Crew state directory: {path}") from exc
    if any(part in {"", ".", ".."} for part in relative.parts):
        raise CrewError(f"DBZ Crew state path contains an unsafe component: {path}")
    return relative.parts


@contextmanager
def _open_state_directory(path: Path, *, create: bool) -> Iterator[int]:
    parts = _state_relative_parts(path)
    with _open_state_root(create=create) as root_descriptor:
        descriptors: list[int] = []
        try:
            current_descriptor = root_descriptor
            current_path = state_root()
            for part in parts:
                current_path /= part
                current_descriptor = _open_child_directory(
                    current_descriptor,
                    part,
                    current_path,
                    create=create,
                    private=True,
                )
                descriptors.append(current_descriptor)
            yield current_descriptor
        finally:
            for descriptor in reversed(descriptors):
                os.close(descriptor)


@contextmanager
def _open_state_parent(path: Path, *, create: bool) -> Iterator[tuple[int, str]]:
    parts = _state_relative_parts(path)
    if not parts:
        raise CrewError(f"DBZ Crew state file path names the state directory: {path}")
    with _open_state_directory(path.parent, create=create) as descriptor:
        yield descriptor, path.name


def _existing_state_entry(parent_descriptor: int, name: str, path: Path) -> os.stat_result | None:
    try:
        return os.stat(name, dir_fd=parent_descriptor, follow_symlinks=False)
    except FileNotFoundError:
        return None
    except OSError as exc:
        raise CrewError(f"unable to inspect DBZ Crew state path {path}: {exc}") from exc


def _validate_replaceable_state_file(parent_descriptor: int, name: str, path: Path) -> None:
    info = _existing_state_entry(parent_descriptor, name, path)
    if info is None:
        return
    if stat.S_ISLNK(info.st_mode):
        raise CrewError(f"DBZ Crew state file cannot be a symbolic link: {path}")
    if not stat.S_ISREG(info.st_mode):
        raise CrewError(f"DBZ Crew state path is not a regular file: {path}")
    if info.st_uid != os.getuid():
        raise CrewError(f"DBZ Crew state file is not owned by the current user: {path}")


def ensure_private_directory(path: Path) -> None:
    with _open_state_directory(path, create=True):
        pass


def _write_private_text(path: Path, value: str) -> None:
    with _open_state_parent(path, create=True) as (parent_descriptor, name):
        temporary_name = f".{name}.{os.getpid()}.{uuid.uuid4().hex}.tmp"
        descriptor: int | None = None
        try:
            flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | os.O_NOFOLLOW
            descriptor = os.open(temporary_name, flags, PRIVATE_FILE_MODE, dir_fd=parent_descriptor)
            _validate_owned_file(descriptor, path.with_name(temporary_name))
            with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
                descriptor = None
                handle.write(value)
                handle.flush()
                os.fsync(handle.fileno())
            _validate_replaceable_state_file(parent_descriptor, name, path)
            os.replace(
                temporary_name,
                name,
                src_dir_fd=parent_descriptor,
                dst_dir_fd=parent_descriptor,
            )
        except CrewError:
            raise
        except OSError as exc:
            raise CrewError(f"unable to write DBZ Crew state file {path}: {exc}") from exc
        finally:
            if descriptor is not None:
                os.close(descriptor)
            try:
                os.unlink(temporary_name, dir_fd=parent_descriptor)
            except FileNotFoundError:
                pass
            except OSError as exc:
                raise CrewError(f"unable to remove temporary DBZ Crew state file for {path}: {exc}") from exc


def write_json(path: Path, payload: dict[str, Any]) -> None:
    _write_private_text(path, json.dumps(payload, indent=2, sort_keys=True) + "\n")


@contextmanager
def state_lock(path: Path) -> Iterator[None]:
    lock_path = path.with_suffix(f"{path.suffix}.lock")
    with _open_state_parent(lock_path, create=True) as (parent_descriptor, name):
        info = _existing_state_entry(parent_descriptor, name, lock_path)
        if info is not None:
            if stat.S_ISLNK(info.st_mode):
                raise CrewError(f"DBZ Crew state lock cannot be a symbolic link: {lock_path}")
            if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid():
                raise CrewError(f"DBZ Crew state lock is not a safe current-user file: {lock_path}")
        try:
            flags = os.O_RDWR | os.O_CREAT | os.O_CLOEXEC | os.O_NOFOLLOW
            descriptor = os.open(name, flags, PRIVATE_FILE_MODE, dir_fd=parent_descriptor)
        except OSError as exc:
            raise CrewError(f"unable to open DBZ Crew state lock {lock_path}: {exc}") from exc
        try:
            _validate_owned_file(descriptor, lock_path)
        except BaseException:
            os.close(descriptor)
            raise
        with os.fdopen(descriptor, "r+", encoding="utf-8") as handle:
            fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
            try:
                yield
            finally:
                fcntl.flock(handle.fileno(), fcntl.LOCK_UN)


def write_private_text(path: Path, value: str) -> None:
    _write_private_text(path, value)


def _read_private_text(path: Path, *, missing_ok: bool) -> str | None:
    try:
        with _open_state_parent(path, create=False) as (parent_descriptor, name):
            info = _existing_state_entry(parent_descriptor, name, path)
            if info is None:
                if missing_ok:
                    return None
                raise CrewError(f"DBZ Crew state file is unavailable: {path}")
            if stat.S_ISLNK(info.st_mode):
                raise CrewError(f"DBZ Crew state file cannot be a symbolic link: {path}")
            try:
                descriptor = os.open(name, _state_open_flags(), dir_fd=parent_descriptor)
            except OSError as exc:
                raise CrewError(f"unable to open DBZ Crew state file {path}: {exc}") from exc
            try:
                _validate_owned_file(descriptor, path)
            except BaseException:
                os.close(descriptor)
                raise
            try:
                with os.fdopen(descriptor, "r", encoding="utf-8") as handle:
                    return handle.read()
            except OSError as exc:
                raise CrewError(f"unable to read DBZ Crew state file {path}: {exc}") from exc
    except FileNotFoundError:
        if missing_ok:
            return None
        raise CrewError(f"DBZ Crew state file is unavailable: {path}") from None


def read_private_text(path: Path) -> str:
    value = _read_private_text(path, missing_ok=False)
    assert value is not None
    return value


def read_json(path: Path) -> dict[str, Any] | None:
    value = _read_private_text(path, missing_ok=True)
    if value is None:
        return None
    try:
        payload = json.loads(value)
    except json.JSONDecodeError:
        return None
    return payload if isinstance(payload, dict) else None


def remove_state_file(path: Path, *, missing_ok: bool = False) -> None:
    try:
        with _open_state_parent(path, create=False) as (parent_descriptor, name):
            info = _existing_state_entry(parent_descriptor, name, path)
            if info is None:
                if missing_ok:
                    return
                raise CrewError(f"DBZ Crew state file is unavailable: {path}")
            if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode):
                raise CrewError(f"refusing to remove unexpected DBZ Crew state path: {path}")
            if info.st_uid != os.getuid():
                raise CrewError(f"refusing to remove DBZ Crew state file owned by another user: {path}")
            try:
                os.unlink(name, dir_fd=parent_descriptor)
            except OSError as exc:
                raise CrewError(f"unable to remove DBZ Crew state file {path}: {exc}") from exc
    except FileNotFoundError:
        if not missing_ok:
            raise CrewError(f"DBZ Crew state file is unavailable: {path}") from None


def state_entry_exists(path: Path) -> bool:
    try:
        with _open_state_parent(path, create=False) as (parent_descriptor, name):
            return _existing_state_entry(parent_descriptor, name, path) is not None
    except FileNotFoundError:
        return False


def stable_digest(value: str) -> str:
    return hashlib.sha256(value.encode()).hexdigest()[:20]


def state_path(main_pane: str) -> Path:
    return state_root() / "sessions" / f"{stable_digest(main_pane)}.json"


def principal_ready_path(session_id: str) -> Path:
    return state_root() / "principals" / f"{stable_digest(session_id)}.json"


def event_directory(session_id: str) -> Path:
    return state_root() / "events" / stable_digest(session_id)


def current_pane() -> dict[str, Any]:
    payload = json_from_text(command_text(["herdr", "pane", "current"]))
    for pane in find_values(payload, "pane"):
        if isinstance(pane, dict) and isinstance(pane.get("pane_id"), str):
            return pane
    raise CrewError("Herdr did not return the current pane")


def current_state() -> tuple[dict[str, Any], Path, dict[str, Any]]:
    pane = current_pane()
    pane_id = pane.get("pane_id")
    if not isinstance(pane_id, str):
        raise CrewError("current Herdr pane has no pane_id")
    path = state_path(pane_id)
    state = read_json(path)
    if state is None:
        raise CrewError("no dbz-crew workers are recorded for this Herdr pane")
    state.pop("status", None)
    state.pop("preflight", None)
    state.pop("session_id", None)
    state["main_pane"] = pane_id
    state.setdefault("session_key", pane_id)
    state.setdefault("queue", [])
    state.setdefault("workers", {})
    return state, path, pane


def pi_worker_configuration(overrides: dict[str, str | None] | None = None) -> dict[str, str]:
    overrides = overrides or {}
    values = {
        "provider": overrides.get("provider") or os.environ.get("PI_PROVIDER"),
        "model": overrides.get("model") or os.environ.get("PI_MODEL"),
        "thinking": overrides.get("thinking") or os.environ.get("PI_REASONING_LEVEL"),
    }
    missing = [name for name, value in values.items() if not isinstance(value, str) or not value.strip()]
    if missing:
        raise CrewError("missing Pi worker metadata: " + ", ".join(missing))
    resolved = {name: str(value).strip() for name, value in values.items()}
    for name in ("provider", "model"):
        if resolved[name].startswith("-") or "\x00" in resolved[name]:
            raise CrewError(f"invalid Pi worker {name}")
    if resolved["thinking"] not in PI_THINKING_LEVELS:
        raise CrewError(
            "Pi worker thinking must be one of " + ", ".join(sorted(PI_THINKING_LEVELS))
        )
    return resolved


def pi_event_bridge_ready(session_id: str) -> bool:
    marker = read_json(principal_ready_path(session_id))
    if marker is None or marker.get("session_id") != session_id:
        return False
    pid = marker.get("pid")
    if not isinstance(pid, int) or pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except (OSError, ValueError):
        return False
    return True


def pi_integration_installed() -> bool:
    result = command(["herdr", "integration", "status"])
    if result.returncode != 0:
        return False
    return any(
        re.match(r"^pi: (?:installed|current)(?:\s|$)", line.strip())
        for line in result.stdout.splitlines()
    )


def herdr_supports_pi_workers() -> bool:
    result = command(["herdr", "agent", "start", "--help"])
    return result.returncode == 0 and re.search(r"\bpi\b", result.stdout + result.stderr) is not None


def preflight(
    cwd: Path,
    pi_overrides: dict[str, str | None] | None = None,
    *,
    read_only: bool = False,
    in_place: bool = False,
    committed_only: bool = False,
    base: str | None = None,
    allow_mutable_base: bool = False,
) -> dict[str, Any]:
    errors: list[str] = []
    try:
        validate_read_only_options(
            read_only,
            in_place,
            committed_only,
            base,
            allow_mutable_base=allow_mutable_base,
        )
    except CrewError as exc:
        errors.append(str(exc))
    for binary in ("git", "herdr", "pi"):
        if shutil.which(binary) is None:
            errors.append(f"missing command: {binary}")

    repository: Path | None = None
    branch = ""
    head = ""
    main_pane = ""
    main_workspace = ""
    principal_agent = ""
    principal_session_id = ""
    worker_config: dict[str, str] | None = None
    dirty = False
    base_head = ""
    if "missing command: git" not in errors:
        result = command(["git", "rev-parse", "--show-toplevel"], cwd)
        if result.returncode != 0:
            errors.append("current directory is not inside a Git repository")
        else:
            repository = Path(result.stdout.strip()).resolve()
            branch = command(["git", "branch", "--show-current"], repository).stdout.strip()
            current_head = command(["git", "rev-parse", "HEAD"], repository)
            if current_head.returncode != 0:
                errors.append("unable to resolve HEAD")
            else:
                head = current_head.stdout.strip()
                base_head = head

            if not read_only:
                if branch != "main":
                    errors.append("current branch must be main")
                main_ref = command(["git", "rev-parse", "--verify", "main"], repository)
                if main_ref.returncode != 0:
                    errors.append("local main branch does not exist")
                elif head and main_ref.stdout.strip() != head:
                    errors.append("HEAD must equal the local main commit")
            elif committed_only and head:
                selected_base = base or "HEAD"
                commit_revision = f"{selected_base}^{{commit}}"
                resolved = command(["git", "rev-parse", "--verify", commit_revision], repository)
                if resolved.returncode != 0:
                    errors.append(f"unable to resolve read-only base: {selected_base}")
                else:
                    base_head = resolved.stdout.strip()

            status = command(["git", "status", "--porcelain"], repository)
            if status.returncode != 0:
                errors.append("unable to inspect Git status")
            else:
                dirty = bool(status.stdout.strip())
                if dirty and not read_only:
                    errors.append("main worktree must be clean, including untracked files")
            for marker in ("MERGE_HEAD", "REBASE_HEAD", "CHERRY_PICK_HEAD"):
                if command(["git", "rev-parse", "-q", "--verify", marker], repository).returncode == 0:
                    errors.append(f"Git operation in progress: {marker}")

    if "missing command: herdr" not in errors:
        if command(["herdr", "status", "server"]).returncode != 0:
            errors.append("Herdr server is not running")
        else:
            try:
                pane = current_pane()
                pane_agent = pane.get("agent")
                if pane_agent == PI_AGENT_KIND:
                    principal_agent = PI_AGENT_KIND
                else:
                    errors.append("current Herdr pane must be a Pi agent")
                pane_id = pane.get("pane_id")
                if isinstance(pane_id, str):
                    main_pane = pane_id
                else:
                    errors.append("current Herdr pane has no pane_id")
                workspace_id = pane.get("workspace_id")
                if isinstance(workspace_id, str):
                    main_workspace = workspace_id
                else:
                    errors.append("current Herdr pane has no workspace_id")
                pane_cwd = pane.get("cwd")
                if repository and isinstance(pane_cwd, str):
                    try:
                        Path(pane_cwd).resolve().relative_to(repository)
                    except ValueError:
                        errors.append("current Herdr pane is outside this repository")
            except CrewError as exc:
                errors.append(str(exc))

    if principal_agent == PI_AGENT_KIND:
        if not herdr_supports_pi_workers():
            errors.append("Herdr does not support starting Pi workers")
        if not pi_integration_installed():
            errors.append("the official Herdr Pi integration is not installed")
        try:
            worker_config = pi_worker_configuration(pi_overrides)
        except CrewError as exc:
            errors.append(str(exc))
        session_id = os.environ.get("PI_SESSION_ID", "").strip()
        if not session_id:
            errors.append("missing Pi principal session id")
        else:
            principal_session_id = session_id
            if not pi_event_bridge_ready(session_id):
                errors.append("the DBZ Crew Pi event extension is not active; reload or restart Pi")

    return {
        "ok": not errors,
        "errors": errors,
        "repo_root": str(repository) if repository else None,
        "branch": branch or None,
        "main_head": head or None,
        "source_head": head or None,
        "base_head": base_head or None,
        "dirty": dirty,
        "read_only": read_only,
        "read_only_mode": "in-place" if in_place else ("isolated" if read_only else None),
        "committed_only": committed_only,
        "main_pane": main_pane or None,
        "main_workspace": main_workspace or None,
        "principal_agent": principal_agent or None,
        "principal_session_id": principal_session_id or None,
        "worker_config": worker_config,
    }


def require_preflight(
    pi_overrides: dict[str, str | None] | None = None,
    *,
    read_only: bool = False,
    in_place: bool = False,
    committed_only: bool = False,
    base: str | None = None,
    allow_mutable_base: bool = False,
) -> dict[str, Any]:
    result = preflight(
        Path.cwd(),
        pi_overrides,
        read_only=read_only,
        in_place=in_place,
        committed_only=committed_only,
        base=base,
        allow_mutable_base=allow_mutable_base,
    )
    if not result["ok"]:
        raise CrewError("preflight failed: " + "; ".join(result["errors"]))
    return result


def state_for_dispatch(main_pane: str) -> tuple[dict[str, Any], Path]:
    path = state_path(main_pane)
    state = read_json(path)
    if state is None:
        state = {
            "main_pane": main_pane,
            "session_key": main_pane,
            "queue": [],
            "workers": {},
        }
    else:
        # State created by hook-based versions remains usable for completed
        # workers, but no longer carries an activation lifecycle.
        state.pop("status", None)
        state.pop("preflight", None)
        state.pop("session_id", None)
        state["main_pane"] = main_pane
        state.setdefault("session_key", main_pane)
        state.setdefault("queue", [])
        state.setdefault("workers", {})
    return state, path


def record_dispatched_worker(
    main_pane: str,
    task_id: str,
    worker: dict[str, Any],
    allow_parallel: bool,
) -> dict[str, Any]:
    path = state_path(main_pane)
    with state_lock(path):
        state, _ = state_for_dispatch(main_pane)
        workers = state.setdefault("workers", {})
        if not isinstance(workers, dict):
            workers = {}
            state["workers"] = workers
        if task_id in workers:
            raise CrewError(f"worker task id is already recorded: {task_id}")
        active_tasks = active_worker_task_ids(state)
        if active_tasks and not allow_parallel:
            raise CrewError(
                "a worker became active during dispatch: "
                + ", ".join(active_tasks)
                + "; retry with --parallel only for a separately requested task"
            )
        workers[task_id] = worker
        write_json(path, state)
        return state


def remove_recorded_worker(main_pane: str, task_id: str) -> None:
    path = state_path(main_pane)
    with state_lock(path):
        state = read_json(path)
        workers = state.get("workers") if state else None
        if state is None or not isinstance(workers, dict):
            return
        workers.pop(task_id, None)
        write_json(path, state)


def set_recorded_worker_status(main_pane: str, task_id: str, status: str) -> str | None:
    path = state_path(main_pane)
    with state_lock(path):
        state = read_json(path)
        if state is None:
            raise CrewError("DBZ Crew state disappeared while updating a worker")
        worker = worker_record(state, task_id)
        previous = worker.get("status")
        worker["status"] = status
        write_json(path, state)
        return previous if isinstance(previous, str) else None


def remove_worker_after_cleanup(main_pane: str, task_id: str) -> None:
    remove_recorded_worker(main_pane, task_id)


def safe_task_id(value: str) -> str:
    if not TASK_ID_RE.fullmatch(value):
        raise CrewError("task id must match [a-z][a-z0-9-]{0,23}")
    return value


def safe_phase(value: str) -> str:
    if value not in WORKER_PHASES:
        raise CrewError("worker phase must be implementation or rebase")
    return value


def validate_read_only_options(
    read_only: bool,
    in_place: bool,
    committed_only: bool,
    base: str | None,
    *,
    allow_mutable_base: bool,
) -> None:
    if in_place and not read_only:
        raise CrewError("--in-place requires --read-only")
    if committed_only and not read_only:
        raise CrewError("--committed-only requires --read-only")
    if in_place and committed_only:
        raise CrewError("--in-place and --committed-only cannot be combined")
    if read_only and base and not committed_only:
        raise CrewError("--base requires --committed-only in read-only mode")
    if read_only and base and (base.startswith("-") or "\x00" in base):
        raise CrewError("invalid read-only base")
    if base and not read_only and not allow_mutable_base:
        raise CrewError("--base is only available with --read-only --committed-only for preflight")


def safe_relative_path(value: str) -> Path:
    relative = Path(value)
    if not relative.parts or relative.is_absolute() or any(part in {"", ".", ".."} for part in relative.parts):
        raise CrewError(f"unsafe repository-relative path: {value!r}")
    return relative


def file_digest(path: Path) -> str:
    digest = hashlib.sha256()
    try:
        with path.open("rb") as handle:
            while chunk := handle.read(1024 * 1024):
                digest.update(chunk)
    except OSError as exc:
        raise CrewError(f"unable to read snapshot file {path}: {exc}") from exc
    return digest.hexdigest()


def filesystem_entry(root: Path, relative: Path) -> dict[str, Any]:
    path = root / relative
    try:
        metadata = path.lstat()
    except OSError as exc:
        raise CrewError(f"unable to inspect snapshot path {path}: {exc}") from exc
    entry: dict[str, Any] = {
        "path": relative.as_posix(),
        "mode": stat.S_IMODE(metadata.st_mode),
    }
    if stat.S_ISLNK(metadata.st_mode):
        entry.update({"type": "symlink", "target": os.readlink(path)})
    elif stat.S_ISREG(metadata.st_mode):
        entry.update({"type": "file", "size": metadata.st_size, "sha256": file_digest(path)})
    elif stat.S_ISDIR(metadata.st_mode):
        entry["type"] = "directory"
    else:
        entry["type"] = "special"
    return entry


def git_diff_bytes(repository: Path, *, cached: bool = False) -> bytes:
    args = ["git", "diff"]
    if cached:
        args.append("--cached")
    args.extend(["--binary", "--full-index", "--no-ext-diff", "--no-textconv", "HEAD", "--"])
    return bytes_command_output(args, repository)


def untracked_paths(repository: Path) -> list[Path]:
    output = bytes_command_output(
        ["git", "ls-files", "--others", "--exclude-standard", "-z"],
        repository,
    )
    paths = [safe_relative_path(os.fsdecode(value)) for value in output.split(b"\0") if value]
    return sorted(paths, key=lambda path: os.fsencode(path.as_posix()))


def local_export_state(repository: Path) -> tuple[bytes, list[Path], dict[str, Any]]:
    patch = git_diff_bytes(repository)
    paths = untracked_paths(repository)
    state = {
        "head": command_text(["git", "rev-parse", "HEAD"], repository),
        "patch_sha256": hashlib.sha256(patch).hexdigest(),
        "untracked": [filesystem_entry(repository, path) for path in paths],
    }
    return patch, paths, state


def ensure_copy_parent(root: Path, relative: Path) -> Path:
    current = root
    for part in relative.parts[:-1]:
        current /= part
        if os.path.lexists(current):
            metadata = current.lstat()
            if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISDIR(metadata.st_mode):
                raise CrewError(f"unsafe untracked destination parent: {current}")
        else:
            current.mkdir()
    destination = root / relative
    if os.path.lexists(destination):
        raise CrewError(f"untracked snapshot destination already exists: {destination}")
    return destination


def copy_untracked_path(source_root: Path, destination_root: Path, relative: Path) -> None:
    source = source_root / relative
    try:
        source.parent.resolve(strict=True).relative_to(source_root.resolve())
    except (OSError, ValueError) as exc:
        raise CrewError(f"unsafe untracked snapshot source: {source}") from exc
    destination = ensure_copy_parent(destination_root, relative)
    try:
        metadata = source.lstat()
        if stat.S_ISLNK(metadata.st_mode):
            os.symlink(os.readlink(source), destination)
        elif stat.S_ISREG(metadata.st_mode):
            shutil.copy2(source, destination, follow_symlinks=False)
        else:
            raise CrewError(f"unsupported untracked snapshot entry: {source}")
    except OSError as exc:
        raise CrewError(f"unable to copy untracked snapshot entry {source}: {exc}") from exc


def materialize_local_snapshot(
    source_root: Path,
    destination_root: Path,
    patch: bytes,
    paths: list[Path],
) -> None:
    if patch:
        applied = subprocess.run(
            ["git", "apply", "--binary", "-"],
            cwd=destination_root,
            input=patch,
            capture_output=True,
            text=False,
            check=False,
        )
        if applied.returncode != 0:
            detail = os.fsdecode(applied.stderr).strip() or os.fsdecode(applied.stdout).strip()
            raise CrewError(f"unable to apply the local read-only snapshot: {detail or 'git apply failed'}")
    for relative in paths:
        copy_untracked_path(source_root, destination_root, relative)


def filesystem_manifest(repository: Path) -> list[dict[str, Any]]:
    entries: list[dict[str, Any]] = []

    def visit(directory: Path, relative_directory: Path) -> None:
        try:
            children = sorted(os.scandir(directory), key=lambda entry: os.fsencode(entry.name))
        except OSError as exc:
            raise CrewError(f"unable to inspect snapshot directory {directory}: {exc}") from exc
        for child in children:
            relative = relative_directory / child.name
            if not relative_directory.parts and child.name == ".git":
                continue
            entry = filesystem_entry(repository, relative)
            entries.append(entry)
            if entry["type"] == "directory":
                visit(Path(child.path), relative)

    visit(repository, Path())
    return entries


def worktree_manifest(repository: Path) -> dict[str, Any]:
    return {
        "head": command_text(["git", "rev-parse", "HEAD"], repository),
        "branch": command_text(["git", "branch", "--show-current"], repository),
        "index_sha256": hashlib.sha256(git_diff_bytes(repository, cached=True)).hexdigest(),
        "entries": filesystem_manifest(repository),
    }


def manifest_differences(before: dict[str, Any], after: dict[str, Any]) -> list[str]:
    differences: list[str] = []
    for key, label in (("head", "[HEAD]"), ("branch", "[branch]"), ("index_sha256", "[index]")):
        if before.get(key) != after.get(key):
            differences.append(label)
    before_entries = {
        entry["path"]: entry
        for entry in before.get("entries", [])
        if isinstance(entry, dict) and isinstance(entry.get("path"), str)
    }
    after_entries = {
        entry["path"]: entry
        for entry in after.get("entries", [])
        if isinstance(entry, dict) and isinstance(entry.get("path"), str)
    }
    differences.extend(
        path
        for path in sorted(set(before_entries) | set(after_entries))
        if before_entries.get(path) != after_entries.get(path)
    )
    return differences


def worker_name(task_id: str, state: dict[str, Any]) -> str:
    session = str(state.get("session_key", "session"))
    suffix = hashlib.sha256(session.encode()).hexdigest()[:6]
    return f"crew-{task_id[:17]}-{suffix}"[:32]


def active_worker_task_ids(state: dict[str, Any]) -> list[str]:
    workers = state.get("workers")
    if not isinstance(workers, dict):
        return []
    return [
        task_id
        for task_id, worker in workers.items()
        if isinstance(task_id, str)
        and isinstance(worker, dict)
        and worker.get("status") in {"running", "working", "rebasing"}
    ]


def worker_record(state: dict[str, Any], task_id: str) -> dict[str, Any]:
    workers = state.get("workers")
    if not isinstance(workers, dict):
        raise CrewError("no tracked dbz-crew workers are available")
    worker = workers.get(task_id)
    if not isinstance(worker, dict):
        raise CrewError(f"unknown worker task id: {task_id}")
    return worker


def task_path(main_pane: str, task_id: str, phase: str = "implementation") -> Path:
    digest = hashlib.sha256(main_pane.encode()).hexdigest()[:20]
    suffix = "" if phase == "implementation" else f".{phase}"
    return state_root() / "tasks" / digest / f"{task_id}{suffix}.txt"


def result_path(main_pane: str, task_id: str, phase: str = "implementation") -> Path:
    digest = hashlib.sha256(main_pane.encode()).hexdigest()[:20]
    suffix = "" if phase == "implementation" else f".{phase}"
    return state_root() / "results" / digest / f"{task_id}{suffix}.md"


def snapshot_path(main_pane: str, task_id: str) -> Path:
    digest = hashlib.sha256(main_pane.encode()).hexdigest()[:20]
    return state_root() / "snapshots" / digest / f"{task_id}.json"


def worktree_path(repo_root: Path, branch: str) -> Path:
    repository_id = hashlib.sha256(str(repo_root).encode()).hexdigest()[:20]
    branch_slug = branch.replace("/", "-")
    return state_root() / "worktrees" / repository_id / branch_slug


def cleanup_failed_dispatch(
    repo_root: Path,
    branch: str,
    worktree: Path,
    tab_id: str | None,
    worktree_created: bool,
) -> str | None:
    failures: list[str] = []
    if tab_id:
        closed = command(["herdr", "tab", "close", tab_id])
        if closed.returncode != 0:
            failures.append(closed.stderr.strip() or closed.stdout.strip() or f"unable to close tab {tab_id}")
    if worktree_created and state_entry_exists(worktree):
        removed = command(["git", "worktree", "remove", "--force", str(worktree)], repo_root)
        if removed.returncode != 0:
            failures.append(removed.stderr.strip() or removed.stdout.strip() or f"unable to remove {worktree}")
    if worktree_created and command(
        ["git", "show-ref", "--verify", "--quiet", f"refs/heads/{branch}"], repo_root
    ).returncode == 0:
        deleted = command(["git", "branch", "-D", branch], repo_root)
        if deleted.returncode != 0:
            failures.append(deleted.stderr.strip() or deleted.stdout.strip() or f"unable to delete {branch}")
    return "; ".join(failures) or None


def worker_start_command(
    name: str,
    pane: str,
    worker_config: dict[str, str],
) -> list[str]:
    return [
        "herdr", "agent", "start", name, "--kind", PI_AGENT_KIND, "--pane", pane,
        "--timeout", "30000", "--", "--provider", worker_config["provider"],
        "--model", worker_config["model"], "--thinking", worker_config["thinking"],
    ]


def launch_monitor(
    monitor_pane: str,
    main_pane: str,
    worker: str,
    task_id: str,
    prompt_file: Path,
    principal_session_id: str,
    phase: str = "implementation",
) -> None:
    monitor_args = [
        "herdr", "pane", "run", monitor_pane,
        str(Path(__file__).resolve()), "monitor",
        "--main-pane", main_pane, "--worker", worker, "--task-id", task_id,
        "--prompt-file", str(prompt_file), "--phase", phase,
        "--principal-session-id", principal_session_id,
    ]
    monitor = command(monitor_args)
    if monitor.returncode != 0:
        raise CrewError(monitor.stderr.strip() or monitor.stdout.strip() or "unable to start worker monitor")


def dispatch(args: argparse.Namespace) -> None:
    task_id = safe_task_id(args.task_id)
    ensure_private_directory(state_root())
    validate_read_only_options(
        args.read_only,
        args.in_place,
        args.committed_only,
        args.base,
        allow_mutable_base=True,
    )
    overrides = {
        "provider": args.worker_provider,
        "model": args.worker_model,
        "thinking": args.worker_thinking,
    }
    check = require_preflight(
        overrides,
        read_only=args.read_only,
        in_place=args.in_place,
        committed_only=args.committed_only,
        base=args.base,
        allow_mutable_base=True,
    )
    main_pane = check["main_pane"]
    main_workspace = check["main_workspace"]
    principal_agent = check["principal_agent"]
    principal_session_id = check["principal_session_id"]
    worker_config = check["worker_config"]
    assert isinstance(main_pane, str)
    assert isinstance(main_workspace, str)
    if principal_agent != PI_AGENT_KIND:
        raise CrewError("Pi principal metadata is unavailable after preflight")
    if not isinstance(principal_session_id, str):
        raise CrewError("Pi principal session metadata is unavailable after preflight")
    if not isinstance(worker_config, dict):
        raise CrewError("Pi worker configuration is unavailable after preflight")
    state, _ = state_for_dispatch(main_pane)
    active_tasks = active_worker_task_ids(state)
    if active_tasks and not args.parallel:
        raise CrewError(
            "a worker is already active: "
            + ", ".join(active_tasks)
            + "; start another only for a separately requested task with --parallel"
        )

    repo_root = Path(str(check["repo_root"]))
    read_only_mode = "in-place" if args.in_place else ("isolated" if args.read_only else None)
    suffix = hashlib.sha256(str(state["session_key"]).encode()).hexdigest()[:8]
    branch: str | None = None
    if not args.in_place:
        branch = f"dbz-crew/{suffix}/{task_id}"
        if command(
            ["git", "show-ref", "--verify", "--quiet", f"refs/heads/{branch}"],
            repo_root,
        ).returncode == 0:
            raise CrewError(f"worker branch already exists: {branch}")
        worker_path = worktree_path(repo_root, branch)
        if state_entry_exists(worker_path):
            raise CrewError(f"worker worktree path already exists: {worker_path}")
    else:
        worker_path = repo_root

    if args.read_only:
        base = check.get("base_head")
        if not isinstance(base, str):
            raise CrewError("read-only preflight did not resolve a base commit")
    else:
        base = args.base or "main"
        command_text(["git", "rev-parse", "--verify", base], repo_root)

    tab_id: str | None = None
    prompt_file = task_path(main_pane, task_id)
    baseline_file = snapshot_path(main_pane, task_id) if args.read_only else None
    worker_recorded = False
    worktree_created = False
    try:
        local_patch = b""
        local_paths: list[Path] = []
        export_before: dict[str, Any] | None = None
        if args.read_only and not args.in_place and not args.committed_only:
            local_patch, local_paths, export_before = local_export_state(repo_root)
            if export_before.get("head") != check.get("source_head"):
                raise CrewError("the source HEAD changed after read-only preflight")

        if not args.in_place:
            assert branch is not None
            ensure_private_directory(worker_path.parent)
            command_text(["git", "worktree", "add", "-b", branch, str(worker_path), base], repo_root)
            worktree_created = True
            if export_before is not None:
                materialize_local_snapshot(repo_root, worker_path, local_patch, local_paths)
                _, _, export_after = local_export_state(repo_root)
                if export_after != export_before:
                    raise CrewError("the source worktree changed while the read-only snapshot was captured")

        if baseline_file is not None:
            write_json(baseline_file, worktree_manifest(worker_path))

        tab = command(
            [
                "herdr", "tab", "create", "--workspace", main_workspace, "--cwd", str(worker_path),
                "--label", f"crew:{task_id}", "--no-focus",
            ]
        )
        if tab.returncode != 0:
            raise CrewError(tab.stderr.strip() or tab.stdout.strip() or "unable to create worker tab")
        tab_payload = json_from_text(tab.stdout)
        root_pane = first_string(tab_payload, "pane_id")
        tab_id = first_string(tab_payload, "tab_id")
        if root_pane is None or tab_id is None:
            raise CrewError("Herdr did not return a worker tab and root pane")

        name = worker_name(task_id, state)
        started = command(worker_start_command(name, root_pane, worker_config))
        if started.returncode != 0:
            raise CrewError(
                started.stderr.strip()
                or started.stdout.strip()
                or "unable to start Pi worker"
            )
        split = command([
            "herdr", "pane", "split", root_pane, "--direction", "down",
            "--cwd", str(worker_path), "--no-focus",
        ])
        if split.returncode != 0:
            raise CrewError(split.stderr.strip() or split.stdout.strip() or "unable to create worker monitor pane")
        monitor_pane = first_string(json_from_text(split.stdout), "pane_id")
        if monitor_pane is None or monitor_pane == root_pane:
            raise CrewError("Herdr did not return a worker monitor pane")

        if args.read_only:
            location = (
                "You are sharing the principal's live worktree. Other processes may change it concurrently. "
                if args.in_place
                else "Work only in this isolated read-only snapshot. "
            )
            worker_prompt = (
                "You are a DBZ-CREW read-only exploratory worker. "
                + location
                + "Do not create, modify, remove, stage, or commit repository files. Avoid commands that "
                "write generated files, caches, dependency state, or Git metadata. Do not create child agents, "
                "merge, push, rebase, or remove worktrees. If a tool may have written to the repository, say so. "
                "Finish your final response with `DBZ-CREW RESULT:` followed by summary, validation, and blockers.\n\n"
                + args.prompt
            )
        else:
            worker_prompt = (
                "You are a DBZ-CREW worker. Work only in this assigned worktree. Do not create child agents, "
                "change main, merge, push, rebase main, or remove worktrees. Keep unrelated files untouched. "
                "Do not run `dbz-crew preflight`: it validates the principal's main worktree and will correctly "
                "fail in a worker branch. "
                "If you change repository files, commit the finished work with a Conventional Commit. Finish your "
                "final response with `DBZ-CREW RESULT:` followed by summary, validation, and blockers.\n\n"
                + args.prompt
            )
        write_private_text(prompt_file, worker_prompt)

        record_dispatched_worker(
            main_pane,
            task_id,
            {
                "agent": name,
                "agent_kind": principal_agent,
                "branch": branch,
                "workspace": main_workspace,
                "tab": tab_id,
                "worktree": str(worker_path),
                "worker_pane": root_pane,
                "monitor_pane": monitor_pane,
                "principal_session_id": principal_session_id,
                "worker_config": worker_config,
                "status": "running",
                "read_only": args.read_only,
                "read_only_mode": read_only_mode,
                "committed_only": args.committed_only,
                "snapshot": str(baseline_file) if baseline_file else None,
                "repo_root": str(repo_root),
                "source_head": check.get("source_head"),
                "base_head": base,
            },
            args.parallel,
        )
        worker_recorded = True

        launch_monitor(
            monitor_pane, main_pane, name, task_id, prompt_file, principal_session_id,
        )
    except CrewError as exc:
        if worker_recorded:
            remove_recorded_worker(main_pane, task_id)
        remove_state_file(prompt_file, missing_ok=True)
        if baseline_file is not None:
            remove_state_file(baseline_file, missing_ok=True)
        cleanup_error = cleanup_failed_dispatch(
            repo_root, branch or "", worker_path, tab_id, worktree_created,
        )
        if cleanup_error:
            raise CrewError(f"{exc}; dispatch cleanup failed: {cleanup_error}") from exc
        raise

    print(json.dumps({
        "task_id": task_id,
        "worker": name,
        "agent_kind": principal_agent,
        "branch": branch,
        "workspace": main_workspace,
        "tab": tab_id,
        "worktree": None if args.in_place else str(worker_path),
        "cwd": str(worker_path),
        "monitor_pane": monitor_pane,
        "worker_config": worker_config,
        "read_only": args.read_only,
        "read_only_mode": read_only_mode,
        "committed_only": args.committed_only,
    }, indent=2))


def event_status(payload: str) -> str:
    try:
        parsed = json_from_text(payload)
    except CrewError:
        return "failed"
    for candidate in find_values(parsed, "agent_status"):
        if candidate in {"done", "idle"}:
            return "done"
        if candidate == "blocked":
            return "blocked"
        if candidate == "working":
            return "failed"
    return "failed"


def completion_event_text(
    task_id: str,
    phase: str,
    status: str,
    output_file: Path,
    *,
    read_only: bool = False,
) -> str:
    if read_only:
        return (
            f"DBZ-CREW EVENT: read-only worker {task_id} {phase} is {status}. Read {output_file}, "
            "inspect the worker state with `dbz-crew status`, and report it to the user. Validated "
            "read-only resources are cleaned automatically; failed validation resources are retained."
        )
    return (
        f"DBZ-CREW EVENT: worker {task_id} {phase} is {status}. Read {output_file}, inspect "
        "the worker state with `dbz-crew status`, report it to the user, and await an explicit user "
        "decision before rebase, merge, or cleanup."
    )


def append_event(
    main_pane: str,
    event_id: str,
    task_id: str,
    phase: str,
    status: str,
    output_file: Path,
) -> None:
    path = state_path(main_pane)
    with state_lock(path):
        state = read_json(path)
        if state is None:
            return
        queue = state.setdefault("queue", [])
        if not isinstance(queue, list):
            queue = []
            state["queue"] = queue
        queue.append({
            "event_id": event_id,
            "task_id": task_id,
            "phase": phase,
            "status": status,
            "result": str(output_file),
        })
        workers = state.get("workers")
        if isinstance(workers, dict) and isinstance(workers.get(task_id), dict):
            workers[task_id]["status"] = status
            workers[task_id][f"{phase}_result"] = str(output_file)
            if phase == "implementation":
                workers[task_id]["result"] = str(output_file)
        write_json(path, state)


def write_completion_event(
    event_id: str,
    principal_session_id: str,
    task_id: str,
    phase: str,
    status: str,
    output_file: Path,
    message: str | None = None,
) -> Path:
    event_path = event_directory(principal_session_id) / f"{event_id}.json"
    write_json(event_path, {
        "id": event_id,
        "principal_session_id": principal_session_id,
        "task_id": task_id,
        "phase": phase,
        "status": status,
        "result": str(output_file),
        "created_at": int(time.time() * 1000),
        "message": message or completion_event_text(task_id, phase, status, output_file),
    })
    return event_path


def recorded_worker(main_pane: str, task_id: str) -> dict[str, Any]:
    state = read_json(state_path(main_pane))
    if state is None:
        raise CrewError("DBZ Crew state is unavailable while validating a worker")
    return worker_record(state, task_id)


def read_only_baseline(worker: dict[str, Any]) -> tuple[Path, dict[str, Any]]:
    value = worker.get("snapshot")
    if not isinstance(value, str):
        raise CrewError("read-only worker has no recorded snapshot")
    path = Path(value)
    _state_relative_parts(path)
    baseline = read_json(path)
    if baseline is None:
        raise CrewError(f"read-only snapshot is unavailable: {path}")
    return path, baseline


def remove_isolated_read_only_resources(
    worker: dict[str, Any],
    baseline: dict[str, Any],
) -> None:
    repo_value = worker.get("repo_root")
    branch = worker.get("branch")
    worktree_value = worker.get("worktree")
    if not all(isinstance(value, str) for value in (repo_value, branch, worktree_value)):
        raise CrewError("read-only worker has incomplete cleanup metadata")
    assert isinstance(repo_value, str)
    assert isinstance(branch, str)
    assert isinstance(worktree_value, str)
    repo_root = Path(repo_value).resolve()
    worktree = Path(os.path.abspath(worktree_value))
    expected_worktree = Path(os.path.abspath(worktree_path(repo_root, branch)))
    if worktree != expected_worktree:
        raise CrewError(f"refusing unexpected read-only worktree path: {worktree}")
    try:
        worktree_metadata = worktree.lstat()
    except OSError as exc:
        raise CrewError(f"read-only worktree is unavailable: {worktree}") from exc
    if stat.S_ISLNK(worktree_metadata.st_mode) or not stat.S_ISDIR(worktree_metadata.st_mode):
        raise CrewError(f"refusing unsafe read-only worktree: {worktree}")
    differences = manifest_differences(baseline, worktree_manifest(worktree))
    if differences:
        raise CrewError("read-only worktree changed before automatic cleanup: " + ", ".join(differences[:20]))
    branch_head = command_text(["git", "rev-parse", branch], repo_root)
    if branch_head != baseline.get("head"):
        raise CrewError(f"read-only branch advanced unexpectedly: {branch}")
    removed = command(["git", "worktree", "remove", "--force", str(worktree)], repo_root)
    if removed.returncode != 0:
        raise CrewError(removed.stderr.strip() or removed.stdout.strip() or f"unable to remove {worktree}")
    deleted = command(["git", "branch", "-D", branch], repo_root)
    if deleted.returncode != 0:
        raise CrewError(deleted.stderr.strip() or deleted.stdout.strip() or f"unable to delete {branch}")


def launch_read_only_finalizer(main_pane: str, task_id: str, tab_id: str) -> None:
    try:
        subprocess.Popen(
            [
                sys.executable,
                str(Path(__file__).resolve()),
                "finalize-read-only",
                "--main-pane",
                main_pane,
                "--task-id",
                task_id,
                "--tab",
                tab_id,
            ],
            cwd="/",
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except OSError as exc:
        raise CrewError(f"unable to start read-only finalizer: {exc}") from exc


def finalize_read_only(args: argparse.Namespace) -> None:
    time.sleep(0.25)
    try:
        worker = recorded_worker(args.main_pane, args.task_id)
    except CrewError:
        return
    if not worker.get("read_only") or worker.get("tab") != args.tab:
        return
    try:
        snapshot_file, _ = read_only_baseline(worker)
    except CrewError:
        snapshot_file = None
    closed = command(["herdr", "tab", "close", args.tab])
    if closed.returncode != 0:
        detail = closed.stderr.strip() or closed.stdout.strip() or f"unable to close tab {args.tab}"
        command([
            "herdr", "notification", "show", f"DBZ Crew: {args.task_id}",
            "--body", f"Read-only auto-cleanup failed: {detail}", "--sound", "request",
        ])
        return
    remove_recorded_worker(args.main_pane, args.task_id)
    if snapshot_file is not None:
        remove_state_file(snapshot_file, missing_ok=True)


def monitor(args: argparse.Namespace) -> None:
    phase = safe_phase(args.phase)
    prompt = read_private_text(Path(args.prompt_file))
    waited = command([
        "herdr", "agent", "prompt", args.worker, prompt, "--wait",
        "--until", "done", "--until", "idle", "--until", "blocked",
    ])
    status = event_status(waited.stdout) if waited.returncode == 0 else "failed"
    read = command(["herdr", "agent", "read", args.worker, "--source", "recent-unwrapped", "--lines", "160"])
    output = read.stdout if read.returncode == 0 else (read.stderr or "Worker output was unavailable.")
    output_file = result_path(args.main_pane, args.task_id, phase)

    worker = recorded_worker(args.main_pane, args.task_id)
    read_only = bool(worker.get("read_only")) and phase == "implementation"
    read_only_mode = worker.get("read_only_mode") if read_only else None
    finalizer_tab: str | None = None
    validation_note = ""
    cleanup_error: CrewError | None = None
    if read_only:
        try:
            _, baseline = read_only_baseline(worker)
            worktree_value = worker.get("worktree")
            if not isinstance(worktree_value, str):
                raise CrewError("read-only worker has no worktree path")
            differences = manifest_differences(baseline, worktree_manifest(Path(worktree_value)))
            if differences:
                displayed = ", ".join(differences[:50])
                suffix = "" if len(differences) <= 50 else f" (+{len(differences) - 50} more)"
                if read_only_mode == "isolated":
                    status = "failed"
                    validation_note = f"\n\nDBZ-CREW READ-ONLY VIOLATION: {displayed}{suffix}\n"
                else:
                    validation_note = (
                        "\n\nDBZ-CREW READ-ONLY WARNING: the shared worktree changed during the worker run; "
                        f"the changes cannot be attributed to the worker: {displayed}{suffix}\n"
                    )
            elif read_only_mode == "isolated":
                write_private_text(output_file, output + validation_note)
                try:
                    remove_isolated_read_only_resources(worker, baseline)
                except CrewError as exc:
                    cleanup_error = exc
                    status = "failed"
                    validation_note += f"\n\nDBZ-CREW AUTO-CLEANUP FAILED: {exc}\n"
            tab = worker.get("tab")
            can_finalize = read_only_mode == "in-place" or not differences
            if cleanup_error is None and can_finalize and isinstance(tab, str):
                finalizer_tab = tab
        except CrewError as exc:
            if read_only_mode == "isolated":
                status = "failed"
                validation_note += f"\n\nDBZ-CREW READ-ONLY VALIDATION FAILED: {exc}\n"
            else:
                validation_note += f"\n\nDBZ-CREW READ-ONLY WARNING: validation unavailable: {exc}\n"
                tab = worker.get("tab")
                if isinstance(tab, str):
                    finalizer_tab = tab

    write_private_text(output_file, output + validation_note)
    event_id = f"{args.task_id}-{phase}-{uuid.uuid4().hex}"
    append_event(args.main_pane, event_id, args.task_id, phase, status, output_file)

    sound = "request" if status in {"blocked", "failed"} else "done"
    body = f"{args.task_id} ({phase}): {status}. Result: {output_file}"
    command(["herdr", "notification", "show", f"DBZ Crew: {args.task_id}", "--body", body, "--sound", sound])
    event = completion_event_text(args.task_id, phase, status, output_file, read_only=read_only)
    if not args.principal_session_id:
        raise CrewError("Pi completion event has no principal session id")
    write_completion_event(
        event_id, args.principal_session_id, args.task_id, phase, status, output_file, event,
    )

    if finalizer_tab is not None:
        try:
            launch_read_only_finalizer(args.main_pane, args.task_id, finalizer_tab)
        except CrewError as exc:
            command([
                "herdr", "notification", "show", f"DBZ Crew: {args.task_id}",
                "--body", str(exc), "--sound", "request",
            ])


def rebase(args: argparse.Namespace) -> None:
    task_id = safe_task_id(args.task_id)
    state, _, _ = current_state()
    check = require_preflight()
    worker = worker_record(state, task_id)
    if worker.get("read_only"):
        raise CrewError(f"read-only worker {task_id} cannot be rebased")
    if worker.get("status") in {"running", "working", "rebasing"}:
        raise CrewError(f"worker {task_id} is still active; wait for its result before requesting a rebase")
    if check.get("principal_agent") != PI_AGENT_KIND:
        raise CrewError("current principal is not Pi")
    worker_agent = worker.get("agent_kind")
    if worker_agent != PI_AGENT_KIND:
        raise CrewError(f"worker {task_id} is not a supported Pi worker")
    principal_session_id = worker.get("principal_session_id")
    current_session_id = check.get("principal_session_id")
    if not isinstance(principal_session_id, str) or principal_session_id != current_session_id:
        raise CrewError(f"resume the original Pi session before rebasing worker {task_id}")
    branch = worker.get("branch")
    worktree_value = worker.get("worktree")
    agent = worker.get("agent")
    monitor_pane = worker.get("monitor_pane")
    main_pane = check["main_pane"]
    if not all(isinstance(value, str) for value in (branch, worktree_value, agent, monitor_pane, main_pane)):
        raise CrewError(f"worker {task_id} has incomplete rebase metadata")
    assert isinstance(branch, str)
    assert isinstance(worktree_value, str)
    assert isinstance(agent, str)
    assert isinstance(monitor_pane, str)
    assert isinstance(main_pane, str)
    worktree = Path(worktree_value)
    if not worktree.is_dir():
        raise CrewError(f"worker {task_id} worktree is unavailable: {worktree}")
    if command(["git", "status", "--porcelain"], worktree).stdout.strip():
        raise CrewError(f"refusing to rebase a dirty worker worktree: {worktree}")
    current_branch = command_text(["git", "branch", "--show-current"], worktree)
    if current_branch != branch:
        raise CrewError(f"worker {task_id} is on {current_branch or 'detached HEAD'}, not {branch}")

    prompt_file = task_path(main_pane, task_id, "rebase")
    write_private_text(
        prompt_file,
        "You are resuming your completed DBZ-CREW implementation worker after an explicit user request. "
        f"Rebase your branch `{branch}` onto the current local `main`. Resolve conflicts, run relevant "
        "validation, and report the resulting commit. Do not run `dbz-crew preflight`: it validates the "
        "principal's main worktree and will correctly fail in a worker branch. Do not merge, push, delete "
        "worktrees, or rebase the main branch itself. Finish with `DBZ-CREW RESULT:` followed by summary, "
        "validation, and blockers.",
    )
    previous_status = set_recorded_worker_status(main_pane, task_id, "rebasing")
    try:
        assert isinstance(principal_session_id, str)
        launch_monitor(
            monitor_pane, main_pane, agent, task_id, prompt_file,
            principal_session_id, "rebase",
        )
    except CrewError:
        set_recorded_worker_status(main_pane, task_id, previous_status or "done")
        remove_state_file(prompt_file, missing_ok=True)
        raise
    print(json.dumps({
        "task_id": task_id, "branch": branch, "worker": agent, "phase": "rebase",
        "worktree": str(worktree), "monitor_pane": monitor_pane,
    }, indent=2))


def integrate(args: argparse.Namespace) -> None:
    state, _, _ = current_state()
    check = require_preflight()
    repo_root = Path(str(check["repo_root"]))
    branch = args.branch
    workers = state.get("workers")
    worker_values = workers.values() if isinstance(workers, dict) else []
    matching_worker = next(
        (
            worker
            for worker in worker_values
            if isinstance(worker, dict) and worker.get("branch") == branch
        ),
        None,
    )
    if isinstance(matching_worker, dict) and matching_worker.get("read_only"):
        raise CrewError(f"read-only branch cannot be integrated: {branch}")
    command_text(["git", "rev-parse", "--verify", branch], repo_root)
    main_head = command_text(["git", "rev-parse", "main"], repo_root)
    merge_base = command_text(["git", "merge-base", "main", branch], repo_root)
    if merge_base != main_head:
        workers = state.get("workers")
        worker_items = workers.items() if isinstance(workers, dict) else []
        task_id = next(
            (
                candidate
                for candidate, worker in worker_items
                if isinstance(candidate, str) and isinstance(worker, dict) and worker.get("branch") == branch
            ),
            None,
        )
        command_hint = f"dbz-crew rebase --task-id {task_id}" if task_id else "an explicit dbz-crew rebase request"
        raise CrewError(f"{branch} is not rebased onto the current main; request {command_hint} before merging")
    merged = command(["git", "merge", "--no-ff", "-m", f"chore(crew): merge {branch}", branch], repo_root)
    if merged.returncode != 0:
        raise CrewError("local merge failed; resolve or abort the merge before continuing")
    print(f"Merged {branch} into main")


def cleanup(args: argparse.Namespace) -> None:
    state, _, _ = current_state()
    check = require_preflight()
    repo_root = Path(str(check["repo_root"]))
    main_pane = check.get("main_pane")
    if not isinstance(main_pane, str):
        raise CrewError("current Herdr pane has no pane_id")
    branch = args.branch
    workers = state.get("workers")
    if not isinstance(workers, dict):
        raise CrewError("no tracked dbz-crew workers are available for cleanup")
    worker = worker_record(state, args.task_id)
    if worker.get("branch") != branch:
        raise CrewError(f"worker {args.task_id} is tracked on {worker.get('branch')}, not {branch}")
    if worker.get("status") in {"running", "working", "rebasing"}:
        raise CrewError(f"worker {args.task_id} is still active; wait for its result before cleanup")
    worktree_value = worker.get("worktree")
    tab_id = worker.get("tab")
    if not isinstance(worktree_value, str) or not isinstance(tab_id, str):
        raise CrewError(f"worker {args.task_id} has incomplete cleanup metadata")
    worktree = Path(worktree_value)
    if worker.get("read_only"):
        if worker.get("read_only_mode") != "isolated":
            raise CrewError(f"in-place read-only worker {args.task_id} has no isolated resources to clean")
        snapshot_file, baseline = read_only_baseline(worker)
        differences = manifest_differences(baseline, worktree_manifest(worktree))
        if differences:
            raise CrewError(
                "refusing to remove a changed read-only worktree: " + ", ".join(differences[:20])
            )
        closed = command(["herdr", "tab", "close", tab_id])
        if closed.returncode != 0:
            raise CrewError(closed.stderr.strip() or closed.stdout.strip() or f"unable to close worker tab {tab_id}")
        remove_isolated_read_only_resources(worker, baseline)
        remove_state_file(snapshot_file, missing_ok=True)
        remove_worker_after_cleanup(main_pane, args.task_id)
        print(f"Removed read-only worker {args.task_id} and branch {branch}")
        return

    merged = command(["git", "merge-base", "--is-ancestor", branch, "main"], repo_root).returncode == 0
    if not merged and not args.superseded_by:
        raise CrewError(f"refusing to remove unmerged branch: {branch}")
    if args.superseded_by:
        replacement = args.superseded_by
        if command(["git", "merge-base", "--is-ancestor", replacement, "main"], repo_root).returncode != 0:
            raise CrewError(f"replacement branch is not merged into main: {replacement}")
    if command(["git", "status", "--porcelain"], worktree).stdout.strip():
        raise CrewError(f"refusing to remove dirty worktree: {worktree}")
    closed = command(["herdr", "tab", "close", tab_id])
    if closed.returncode != 0:
        raise CrewError(closed.stderr.strip() or closed.stdout.strip() or f"unable to close worker tab {tab_id}")
    removed = command(["git", "worktree", "remove", str(worktree)], repo_root)
    if removed.returncode != 0:
        raise CrewError(removed.stderr.strip() or removed.stdout.strip() or "worker tab was closed but Git worktree removal failed")
    delete_flag = "-d" if merged else "-D"
    deleted = command(["git", "branch", delete_flag, branch], repo_root)
    if deleted.returncode != 0:
        raise CrewError(deleted.stderr.strip() or deleted.stdout.strip() or "worktree removed but branch was retained")
    remove_worker_after_cleanup(main_pane, args.task_id)
    print(f"Removed worker {args.task_id} and branch {branch}")


def status(_: argparse.Namespace) -> None:
    pane = current_pane()
    pane_id = pane.get("pane_id")
    if not isinstance(pane_id, str):
        raise CrewError("current Herdr pane has no pane_id")
    state = read_json(state_path(pane_id))
    if state is None:
        state = {"main_pane": pane_id, "queue": [], "workers": {}}
    else:
        state.pop("status", None)
        state.pop("preflight", None)
        state.pop("session_id", None)
        state["main_pane"] = pane_id
        state.setdefault("session_key", pane_id)
        state.setdefault("queue", [])
        state.setdefault("workers", {})
    print(json.dumps(state, indent=2, sort_keys=True))


def main() -> None:
    parser = argparse.ArgumentParser(description="Manage a DBZ Crew workflow")
    subparsers = parser.add_subparsers(dest="command", required=True)
    preflight_parser = subparsers.add_parser("preflight")
    preflight_parser.add_argument("--read-only", action="store_true")
    preflight_parser.add_argument("--in-place", action="store_true")
    preflight_parser.add_argument("--committed-only", action="store_true")
    preflight_parser.add_argument("--base")
    dispatch_parser = subparsers.add_parser("dispatch")
    dispatch_parser.add_argument("--task-id", required=True)
    dispatch_parser.add_argument("--prompt", required=True)
    dispatch_parser.add_argument("--base")
    dispatch_parser.add_argument("--read-only", action="store_true")
    dispatch_parser.add_argument("--in-place", action="store_true")
    dispatch_parser.add_argument("--committed-only", action="store_true")
    dispatch_parser.add_argument("--parallel", action="store_true")
    dispatch_parser.add_argument("--worker-provider")
    dispatch_parser.add_argument("--worker-model")
    dispatch_parser.add_argument("--worker-thinking")
    monitor_parser = subparsers.add_parser("monitor")
    monitor_parser.add_argument("--main-pane", required=True)
    monitor_parser.add_argument("--worker", required=True)
    monitor_parser.add_argument("--task-id", required=True)
    monitor_parser.add_argument("--prompt-file", required=True)
    monitor_parser.add_argument("--phase", default="implementation")
    monitor_parser.add_argument("--principal-session-id", required=True)
    integrate_parser = subparsers.add_parser("integrate")
    integrate_parser.add_argument("--branch", required=True)
    rebase_parser = subparsers.add_parser("rebase")
    rebase_parser.add_argument("--task-id", required=True)
    cleanup_parser = subparsers.add_parser("cleanup")
    cleanup_parser.add_argument("--task-id", required=True)
    cleanup_parser.add_argument("--branch", required=True)
    cleanup_parser.add_argument("--superseded-by")
    finalizer_parser = subparsers.add_parser(
        "finalize-read-only",
        help="Finalize read-only worker resources (internal)",
    )
    finalizer_parser.add_argument("--main-pane", required=True)
    finalizer_parser.add_argument("--task-id", required=True)
    finalizer_parser.add_argument("--tab", required=True)
    subparsers.add_parser("status")
    args = parser.parse_args()

    try:
        if args.command == "preflight":
            print(json.dumps(preflight(
                Path.cwd(),
                read_only=args.read_only,
                in_place=args.in_place,
                committed_only=args.committed_only,
                base=args.base,
            ), indent=2))
        elif args.command == "dispatch":
            dispatch(args)
        elif args.command == "monitor":
            monitor(args)
        elif args.command == "integrate":
            integrate(args)
        elif args.command == "rebase":
            rebase(args)
        elif args.command == "cleanup":
            cleanup(args)
        elif args.command == "finalize-read-only":
            finalize_read_only(args)
        elif args.command == "status":
            status(args)
    except CrewError as exc:
        print(f"dbz-crew: {exc}", file=sys.stderr)
        raise SystemExit(1)


if __name__ == "__main__":
    main()
