{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "include": [
    "agents/pi/extensions/**/*.ts",
    "src/**/*.ts",
    "tests/unit/**/*.ts",
    "tests/security/**/*.ts",
    "tests/component/**/*.ts",
    "tests/integration/**/*.ts"
  ]
}
